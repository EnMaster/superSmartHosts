# Super Smart Hosts — example environment
#
# Copy this file to `.env` and adjust. Every variable is optional: leave a
# value empty (or remove the line) to use the built-in default shown below.
#
# The app reads plain environment variables. Load this file either with
#     node --env-file=.env server/index.js        # Node >= 20.6
# or, in a shell,
#     set -a; . ./.env; set +a; npm start

# HTTP port.
PORT=4317

# Bind address (keep it on loopback).
HOST=127.0.0.1

# Directory of config files (`.conf`, `.config`, or extensionless). Absolute
# path. Default: ~/.ssh/config.d
SMH_DIR=

# Main ssh config used for the include check. Default: ~/.ssh/config
SMH_MAIN=

# Terminal backend: auto | iterm | terminal | system.
SMH_TERMINAL=auto

# Set to 1 to skip opening a browser on start (used by the CLI).
SMH_NO_OPEN=

# System hosts file to edit. Default: /etc/hosts
SMH_HOSTS=

# Force privileged hosts-file writes: 1 = always, 0 = never.
# Empty/unset = auto (privileged only when the target is /etc/hosts).
SMH_HOSTS_PRIVILEGED=

# Where hosts-file backups are stored. Default: ~/.super-smart-hosts/backups
SMH_BACKUP_DIR=

# Where config-file backups are stored. Default: ~/.super-smart-hosts/config-backups
SMH_CONFIG_BACKUP_DIR=

# Where the manual environment tags (production/test/none per file and host)
# are stored. Default: ~/.super-smart-hosts (file: environments.json)
SMH_ENV_DIR=
